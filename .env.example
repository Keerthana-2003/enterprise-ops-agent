# OpenAI
OPENAI_API_KEY=sk-...
AGENT_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Or a local open-source model through any OpenAI-compatible server (Ollama shown):
# OPENAI_BASE_URL=http://localhost:11434/v1
# AGENT_MODEL=llama3.1

# Langfuse tracing (optional; free tier at cloud.langfuse.com)
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Signs webhook payloads (X-Signature-SHA256 header) for /runs/async
# WEBHOOK_SECRET=change-me

# Provider: openai (default; OpenAI, Azure or a local OpenAI-compatible server) or bedrock
# LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_REGION=us-east-1
# BEDROCK_PROMPT_CACHE=1

# Runtime for POST /runs: loop (hand-written) or langgraph
# AGENT_RUNTIME=langgraph

# OpenTelemetry export (Datadog Agent OTLP receiver shown)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Cognito auth (set automatically on AWS by Terraform / CDK)
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
# COGNITO_CLIENT_ID=...
